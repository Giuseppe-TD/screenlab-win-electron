{
  "name": "screenlab",
  "version": "2.0.0",
  "description": "Multi-device responsive testing tool",
  "main": "main.js",
  "author": "Tastiere Digitali srls",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "it.tastieredigitali.screenlab",
    "productName": "Screenlab",
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": ["it"],
      "language": "1040"
    }
  }
}
